---
// /play/shift — Műszak 2.0 (ux-2, 2026-11-11): a vezérlő konzol-dizájnjában (PlayLayout + src/styles/shift.css).
// Visszaszámláló, élő elégedettség-sávok, lebegő +$/hangulat jelzések, gépel-jelzés, gombállapotok, záróképernyő
// csillagokkal, opcionális (alapból kikapcsolt) hangok, mobilon vízszintes ügyfél-sáv.
// XSS: az ügyfél- és MI-szöveg csak textContent-tel kerül a DOM-ba (src/scripts/shift/shift-app.ts).
// Stílus: src/styles/shift.css.
//
// A korábbi beágyazott mód (?embed=1, a vezérlő iframe-ablaka) megszűnt: a műszak teljes oldal. Egy régi,
// gyorsítótárazott vezérlő iframe-jéből a kliens kiugrik a felső ablakba.
import PlayLayout from '../../layouts/PlayLayout.astro';
import { pt, clientStrings } from '../../lib/play/strings';
import { achievementMap } from '../../lib/play/achievements-i18n';
import { jsonForScript } from '../../lib/safe-json';
import { getCurrentUser, getDB } from '../../lib/auth';
import { getPlayer } from '../../lib/game/db';
import { getLlmUsageToday, getDailyCap } from '../../lib/game/llm-cap';
import { ECONOMY } from '../../lib/game/economy';
import { loadUpgradeEffects } from '../../lib/game/upgrade-effects';
import { resolveLocale } from '../../lib/i18n/server';
import { t } from '../../lib/i18n';
import { secondsUntilShiftReset, shiftsUsedToday } from '../../lib/game/shift-score';
// Astro-csomagolt, tartalom-hash-es CSS (a public/ alatti fájlt a böngésző a régi változatból szolgálná ki).
import '../../styles/shift.css';

type AnyCtx = Parameters<typeof getCurrentUser>[0];
const ctx = Astro as unknown as AnyCtx;

const user = await getCurrentUser(ctx);
if (!user) return Astro.redirect('/login?next=/play/shift');
const db = getDB(ctx);
if (!db) return new Response('No DB', { status: 500 });
const player = await getPlayer(db, user.id);
if (!player) return Astro.redirect('/play'); // a /play hozza létre a kezdőállást

const locale = await resolveLocale({ request: Astro.request, db, userId: user.id });

// Ugyanaz a lekérdezés, mint a /api/shift/start-ban ('open' + 'in_progress', legrégebbi elöl, max. 10).
const waiting = (await db.prepare(`
  SELECT t.id, t.summary, c.name, c.persona_archetype AS archetype, c.satisfaction
  FROM tickets t JOIN customers c ON t.customer_id = c.id
  WHERE t.player_id = ? AND t.status IN ('open', 'in_progress')
  ORDER BY t.created_at ASC
`).bind(user.id).all<{ id: number; summary: string; name: string; archetype: string; satisfaction: number }>()).results ?? [];
const openCount = waiting.length;
const used = await getLlmUsageToday(db, user.id);
// A fejlesztések (Nagios, CI/CD) több ticketet / MI-választ engednek (2026-11-12, játékmag).
const shiftEff = await loadUpgradeEffects(db as never, user.id);
const shiftLimit = ECONOMY.shift_ticket_limit + (ECONOMY.upgrade_effects ? shiftEff.shift_slots : 0);
const cap = getDailyCap(player.is_pro === 1, ECONOMY.upgrade_effects ? shiftEff.ai_calls : 0);
const capRemaining = Math.max(0, cap - used);
const shiftCap = player.is_pro === 1 ? 5 : 1;
const nowSec = Math.floor(Date.now() / 1000);
const shiftsLeft = Math.max(0, shiftCap - shiftsUsedToday(player as Parameters<typeof shiftsUsedToday>[0], nowSec));
const resetIn = secondsUntilShiftReset(nowSec);
const durText = pt(locale, 'sx.dur', { h: Math.floor(resetIn / 3600), m: Math.floor((resetIn % 3600) / 60) });
const lowBudget = capRemaining < 5;
const canStart = openCount > 0 && shiftsLeft > 0 && !lowBudget;
const peek = waiting.slice(0, 5);
const ARCH = (a: string) => t(locale, `shift.archetype.${a}` as never) || a;
const initials = (n: string) => n.split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join('').toUpperCase();
const hue = (n: string) => { let h = 0; for (const ch of n) h = (h * 31 + ch.charCodeAt(0)) >>> 0; return h % 360; };

const labels = {
  ...clientStrings(locale, ['sx.', 'sh.']),
  end_title: t(locale, 'shift.end_title'),
  err_could_not_start: t(locale, 'shift.error.could_not_start'),
  err_llm_cap: t(locale, 'shift.error.llm_cap'),
  arch: Object.fromEntries(['newbie', 'pro', 'cheapskate', 'karen', 'loyalist', 'ghost', 'drama', 'crypto'].map((a) => [a, ARCH(a)])),
  achievements: achievementMap(locale),
};
const boot = { capRemaining, cap, shiftsLeft: Math.max(0, shiftsLeft - 1), resetIn, locale };
---
<PlayLayout title={t(locale, 'shift.title')} active="shift" crumbs={[pt(locale, 'nav.shift')]}>
  <div class="sx" id="sx" data-phase="pre">
    <section class="panel sx-hud">
      <div class="sx-title">
        <h1>{t(locale, 'shift.title')}</h1>
        <div class="sub">{pt(locale, 'sx.pre.rules', { left: shiftsLeft })}</div>
      </div>
      <div class="sx-stats">
        <div class="sx-stat" data-stat="resolved"><div class="k">{pt(locale, 'sx.hud.resolved')}</div><div class="v">0/{Math.min(shiftLimit, openCount)}</div></div>
        <div class="sx-stat" data-stat="cash"><div class="k">{pt(locale, 'sx.hud.cash')}</div><div class="v">$0</div></div>
        <div class="sx-stat" data-stat="mood"><div class="k">{pt(locale, 'sx.hud.mood')}</div><div class="v">+0</div></div>
        <div class="sx-stat" data-stat="ai"><div class="k">{pt(locale, 'sx.hud.ai_left')}</div><div class="v">{capRemaining}/{cap}</div></div>
      </div>
      <div class="sx-right">
        <button type="button" class="sx-iconbtn" id="sx-sound" aria-pressed="false" title={pt(locale, 'sx.sound_off')}>🔇</button>
        <button type="button" class="sx-endbtn" id="sx-end" hidden>{pt(locale, 'sx.end_btn')}</button>
        <div class="sx-timer" id="sx-timer" role="timer" aria-label={pt(locale, 'sx.hud.time_left')}>
          <svg viewBox="0 0 80 80" aria-hidden="true"><circle class="track" cx="40" cy="40" r="34"></circle><circle class="bar" cx="40" cy="40" r="34" stroke-dasharray="213.6" stroke-dashoffset="0"></circle></svg>
          <div class="t"><span><b id="sx-time">30:00</b><small>{pt(locale, 'sx.hud.time_left')}</small></span></div>
        </div>
      </div>
    </section>

    {canStart && (
      <section class="panel sx-pre" id="sx-pre">
        <div class="l">
          <div class="ico">🎧</div>
          <h2>{pt(locale, 'sx.pre.title')}</h2>
          <div class="wait" set:html={pt(locale, 'sx.pre.waiting', { n: `<b>${Math.min(shiftLimit, openCount)}</b>` })}></div>
          <p class="how">{pt(locale, 'sx.pre.how')}</p>
          <button type="button" class="sx-start" id="sx-start">▶ {pt(locale, 'dash.shift.start')}</button>
        </div>
        <div class="r">
          <h4>{pt(locale, 'sx.queue.title')}</h4>
          {peek.map((w) => (
            <div class="peek">
              <div class="sx-av" style={`--av1:hsl(${hue(w.name)} 70% 55%);--av2:hsl(${(hue(w.name) + 60) % 360} 70% 45%)`}>{initials(w.name)}</div>
              <div class="who"><b>{w.name}</b><span>{w.summary}</span></div>
              <span class={`sx-chip ${w.archetype}`}>{ARCH(w.archetype)}</span>
            </div>
          ))}
          {Math.min(shiftLimit, openCount) > peek.length && <div class="more">{pt(locale, 'sx.pre.more', { n: Math.min(shiftLimit, openCount) - peek.length })}</div>}
        </div>
      </section>
    )}
    {!canStart && openCount === 0 && (
      <section class="panel sx-note"><b>{t(locale, 'shift.inbox_zero_title')}</b>{t(locale, 'shift.inbox_zero_body')}</section>
    )}
    {!canStart && openCount > 0 && shiftsLeft <= 0 && (
      <section class="panel sx-note"><b>{pt(locale, 'nav.shift')}</b>{pt(locale, 'sx.pre.no_shift', { t: durText })}</section>
    )}
    {!canStart && openCount > 0 && shiftsLeft > 0 && lowBudget && (
      <section class="panel sx-note">
        <b>{t(locale, 'shift.low_budget_title').replace('{rem}', String(capRemaining)).replace('{cap}', String(cap))}</b>
        {t(locale, 'shift.low_budget_body')}
      </section>
    )}

    <div class="sx-live" id="sx-live" hidden>
      <div class="panel sx-queue" id="sx-queue" role="region" aria-label={pt(locale, 'sx.queue.title')}></div>
      <section class="panel sx-chat">
        <header class="sx-head" id="sx-head"></header>
        <div class="sx-msgs" id="sx-msgs" aria-live="polite"></div>
        <div class="sx-actions" id="sx-actions">
          <div class="sx-group"><span>{pt(locale, 'sx.group.resolve')}</span><div>
            <button type="button" class="sx-act close good" data-action="close">✓ {t(locale, 'shift.action.close')}</button>
            <button type="button" class="sx-act" data-action="escalate">⇪ {t(locale, 'shift.action.escalate').replace(/\s*\(.*\)/, '')} <span class="cost">−$50</span></button>
            <button type="button" class="sx-act" data-action="refund_100">↺ {t(locale, 'shift.action.refund_100')} <span class="cost">−$5</span></button>
          </div></div>
          <div class="sx-group"><span>{pt(locale, 'sx.group.compensate')}</span><div>
            <button type="button" class="sx-act" data-action="refund_30">{t(locale, 'shift.action.refund_30')} <span class="cost">−$1.50</span></button>
            <button type="button" class="sx-act" data-action="refund_50">{t(locale, 'shift.action.refund_50')} <span class="cost">−$2.50</span></button>
          </div></div>
          <div class="sx-group"><span>{pt(locale, 'sx.group.check')}</span><div>
            <button type="button" class="sx-act good" data-action="investigate">🔍 {t(locale, 'shift.action.investigate').replace(/\s*\(.*\)/, '')} <span class="cost">$0</span></button>
          </div></div>
        </div>
        <div class="sx-quick" id="sx-quick" aria-label={pt(locale, 'sx.quick.label')}>
          <button type="button" data-quick="1">{pt(locale, 'sx.quick.1')}</button>
          <button type="button" data-quick="2">{pt(locale, 'sx.quick.2')}</button>
          <button type="button" data-quick="3">{pt(locale, 'sx.quick.3')}</button>
        </div>
        <div class="sx-compose">
          <textarea id="sx-input" rows="1" maxlength="1000" placeholder={t(locale, 'shift.compose_ph')}></textarea>
          <button type="button" class="sx-send" id="sx-send">{t(locale, 'shift.send')}</button>
        </div>
        <p class="sx-notice" id="sx-notice" hidden aria-live="polite"></p>
      </section>
    </div>
  </div>
  <div class="sx-fx" id="sx-fx" aria-hidden="true"></div>
  <script type="application/json" id="sx-labels" set:html={jsonForScript(labels)}></script>
  <script type="application/json" id="sx-boot" set:html={jsonForScript(boot)}></script>
  <script>
    import '../../scripts/shift/shift-app';
  </script>
</PlayLayout>
