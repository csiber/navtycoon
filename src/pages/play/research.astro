<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Hyperscales — Research</title>
<link rel="stylesheet" href={templateCssUrl} />
<link rel="stylesheet" href={playShellCssUrl} />
<style is:global set:html={pageCss}></style>
<style is:inline>
  body { transition: opacity 200ms ease-out; }
  body.preload { opacity: 0; }
</style>
  <script is:inline defer src="https://stats.aika.hu/aika.js" data-website-id="4edd333d-1a25-461f-bcd3-25a8bcf7f694" data-domains="hyperscales.app,www.hyperscales.app"></script>
</head>
<body class="preload">
<Fragment set:html={shellHtml} />
<script type="application/json" id="rs-i18n" set:html={jsonForScript({
  bought: pt(locale, 'toast.bought_upgrade', { name: '{name}' }),
  error: pt(locale, 'toast.error', { msg: '{msg}' }),
})}></script>
<script is:inline>
  (function () {
    const T = JSON.parse(document.getElementById('rs-i18n').textContent);
    // Csomópont kiválasztása → részletek (korábban a kattintás semmit sem csinált).
    document.querySelectorAll('[data-node]').forEach((n) => {
      n.addEventListener('click', () => {
        const id = n.getAttribute('data-node');
        document.querySelectorAll('[data-node]').forEach((x) => x.classList.toggle('selected', x === n));
        document.querySelectorAll('[data-node-detail]').forEach((d) => { d.hidden = d.getAttribute('data-node-detail') !== id; });
        if (window.innerWidth <= 900) document.querySelector('.rs-side')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });
    document.addEventListener('click', async (ev) => {
      const btn = ev.target instanceof HTMLElement ? ev.target.closest('[data-buy-upgrade]') : null;
      if (!btn || btn.disabled) return;
      btn.disabled = true;
      const orig = btn.textContent;
      btn.textContent = '…';
      try {
        const r = await fetch('/api/game/upgrade', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ upgrade_id: btn.dataset.buyUpgrade }) });
        const j = await r.json().catch(() => ({}));
        if (!r.ok || !j.ok) throw new Error(j.message || j.error || ('HTTP ' + r.status));
        window.hsMoney && window.hsMoney(-parseInt(btn.dataset.cost || '0', 10), T.bought.replace('{name}', btn.dataset.name || ''));
        btn.textContent = '✓';
        setTimeout(() => location.reload(), 1400);
      } catch (e) {
        btn.disabled = false; btn.textContent = orig;
        window.hsToast && window.hsToast(T.error.replace('{msg}', e.message), 'bad');
      }
    });
  })();
</script>
<script is:inline>
  // Hide mock-data flash: remove preload-class once hydrators have run.
  window.addEventListener('load', function () {
    setTimeout(function () { document.body.classList.remove('preload'); }, 30);
  });
</script>
<I18nDashboard />
<DashboardAnims />
<PlayAudio />
<script is:inline src={playShellJsUrl}></script>
</body>
</html>
