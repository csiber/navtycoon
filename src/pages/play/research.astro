class=\"c\"><div class=\"k\">Unlocks</div><div class=\"v\" style=\"font-size:13px;\">Cron Monitoring</div></div>\n              </div>\n            </div>\n            <div class=\"det-action\">\n              <button class=\"btn primary\">Boost research · $40 (-1h 30m)</button>\n            </div>\n          </section>\n\n          <section class=\"panel\">\n            <div class=\"ph\">\n              <h3>Research queue</h3>\n              <span class=\"ph-sub\">// max 2 parallel · Era 1</span>\n            </div>\n            <div class=\"queue-list\">\n              <div class=\"queue-row\">\n                <div class=\"ico\">↺</div>\n                <div>\n                  <div class=\"name\">Auto-restart cron</div>\n                  <div class=\"pb\"><i style=\"width: 62%\"></i></div>\n                </div>\n                <div class=\"ttl\">2h 14m</div>\n              </div>\n              <div class=\"queue-row\" style=\"opacity: .55;\">\n                <div class=\"ico\" style=\"background: var(--panel-3); color: var(--dim); border: 1px dashed var(--line-2);\">＋</div>\n                <div>\n                  <div class=\"name\" style=\"color: var(--dim);\">Slot 2 — empty</div>\n                  <div class=\"pb\"></div>\n                </div>\n                <div class=\"ttl\" style=\"color: var(--dim);\">queue</div>\n              </div>\n            </div>\n          </section>\n\n          <section class=\"panel\">\n            <div class=\"ph\">\n              <h3>How to earn RP</h3>\n              <span class=\"ph-sub\">// Era 1</span>\n            </div>\n            <div style=\"padding: 12px 18px; display: flex; flex-direction: column; gap: 8px;\">\n              <div class=\"effect\"><span class=\"pos\">+2 RP</span><span class=\"lbl\">Resolve P1 ticket within SLA</span></div>\n              <div class=\"effect\"><span class=\"pos\">+5 RP</span><span class=\"lbl\">Write postmortem after outage</span></div>\n              <div class=\"effect\"><span class=\"pos\">+1 RP</span><span class=\"lbl\">Customer at mood &gt; 80 for 7 days</span></div>\n              <div class=\"effect\"><span class=\"pos\">+3 RP</span><span class=\"lbl\">Forum post compliments your SLA</span></div>\n            </div>\n          </section>\n        </div>\n\n      </div>\n    </div>\n  </main>\n</div>\n";
// Közös keret (oldalsáv + felső sáv) valós adatból, a játékos nyelvén — src/lib/play/shell.ts
const locale = await resolveLocale({ request: Astro.request, db, userId: user.id });
const shell = await loadShell(db, player, user, locale, undefined, { hub: hubFromLocals(Astro.locals) });
// „Most ennyit ér" (2026-11-12, játékmag): a játékos mostani ügyfelei, gépei és havidíjai alapján.
const satRows = (await db.prepare('SELECT satisfaction FROM customers WHERE player_id = ? AND is_active = 1')
  .bind(user.id).all<{ satisfaction: number }>()).results ?? [];
const srvRows = (await db.prepare('SELECT type, capacity FROM servers WHERE player_id = ?')
  .bind(user.id).all<{ type: string; capacity: number }>()).results ?? [];
const valueCtx = {
  player, satisfactions: satRows.map((r) => r.satisfaction), servers: srvRows,
  monthlyFeesCents: shell.fleet.monthlyListedCents, effects: shell.effects, owned: ownedIds,
  now: Math.floor(Date.now() / 1000),
};
const valueNow = Object.fromEntries(UPGRADE_SPECS.map((u) => [u.id, upgradeValueNow(locale, u.id, valueCtx)]));
const researchContent = renderResearchContent(shell, UPGRADE_SPECS.map((u) => ({
  id: u.id, era: u.era, cost_usd_cents: u.cost_usd_cents, prereq: u.prereq ?? null,
  status: treeNodes.find((n) => n.id === u.id)?.status ?? 'locked',
})), valueNow);
const shellHtml = applyContent(applyShell(pageHtml, shell, 'research', [pt(locale, 'nav.research')]), researchContent);
