<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Hyperscales — Customers</title>
<link rel="stylesheet" href={templateCssUrl} />
<link rel="stylesheet" href={playShellCssUrl} />
<style is:global set:html={pageCss}></style>
<style is:inline>
  body { transition: opacity 200ms ease-out; }
  body.preload { opacity: 0; }
</style>
  <script is:inline defer src="https://stats.aika.hu/aika.js" data-website-id="4edd333d-1a25-461f-bcd3-25a8bcf7f694" data-domains="hyperscales.app,www.hyperscales.app"></script>
</head>
<body class="preload">
<Fragment set:html={shellHtml} />
<script is:inline>
  (function () {
    // Ügyfél kiválasztása + szűrők (szerveroldali adat, csak megjelenítés-váltás).
    const rows = Array.from(document.querySelectorAll('.cust-row[data-cust]'));
    function select(row) {
      rows.forEach((r) => r.classList.toggle('selected', r === row));
      const id = row.getAttribute('data-cust');
      document.querySelectorAll('[data-cust-prof]').forEach((p) => { p.hidden = p.getAttribute('data-cust-prof') !== id; });
    }
    rows.forEach((r) => r.addEventListener('click', () => select(r)));
    document.querySelectorAll('[data-cf]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const f = btn.getAttribute('data-cf');
        document.querySelectorAll('[data-cf]').forEach((b) => b.classList.toggle('on', b === btn));
        let first = null;
        rows.forEach((r) => {
          const tags = (r.getAttribute('data-tags') || '').split(' ');
          const show = f === 'all' || tags.includes(f);
          r.hidden = !show;
          if (show && !first) first = r;
        });
        if (first) select(first);
      });
    });
  })();
</script>
<script is:inline>
  // Hide mock-data flash: remove preload-class once hydrators have run.
  window.addEventListener('load', function () {
    setTimeout(function () { document.body.classList.remove('preload'); }, 30);
  });
</script>
<I18nDashboard />
<DashboardAnims />
<script is:inline src="/js/play-shell.js"></script>
</body>
</html>
