---
import '../../styles/fonts.css'; // saját kiszolgálású webfontok (GDPR), a Vite hash-elt néven adja ki
import templateCssUrl from '../../styles/template.css?url';
import playShellCssUrl from '../../styles/play-shell.css?url'; // tartalom-hash-es URL: a CSS-változás azonnal kimegy
// /play/settings -- backend wiring complete.
// Profile + LLM cap + Pro status from D1.
import { shiftsUsedToday } from '../../lib/game/shift-score';
import { loadShell, applyShell, applyContent } from '../../lib/play/shell';
import { renderSettingsContent } from '../../lib/play/settings-page';
import { pt } from '../../lib/play/strings';
import { resolveLocale } from '../../lib/i18n/server';
import { getCurrentUser, getDB, getSessionCookie } from '../../lib/auth';
import { jsonForScript } from '../../lib/safe-json';
import { FREE_DAILY_CAP, PRO_DAILY_CAP } from '../../lib/game/llm-cap';
import { getPlayer } from '../../lib/game/db';
import { getAikahubLink, NO_PASSWORD_EMAIL_DOMAIN, linkCsrfToken } from '../../lib/aikahub';
import { getLlmUsageToday, getDailyCap } from '../../lib/game/llm-cap';
import I18nDashboard from '../../components/I18nDashboard.astro';
import DashboardAnims from '../../components/DashboardAnims.astro';

type AnyCtx = Parameters<typeof getCurrentUser>[0];
const ctx = Astro as unknown as AnyCtx;

const user = await getCurrentUser(ctx);
if (!user) return Astro.redirect('/login?next=/play/settings');
const db = getDB(ctx);
if (!db) return new Response('No DB', { status: 500 });
const player = await getPlayer(db, user.id);
if (!player) return Astro.redirect('/play'); // a /play hozza létre a kezdőállást

const isPro = player.is_pro === 1;
// Cast to D1Database for the llm-cap helper (uses @cloudflare/workers-types).
const llmUsed = await getLlmUsageToday(db as unknown as Parameters<typeof getLlmUsageToday>[0], user.id);
const llmCap = getDailyCap(isPro);
const shiftsToday = shiftsUsedToday(player as Parameters<typeof shiftsUsedToday>[0], Math.floor(Date.now() / 1000));

const companyName = player.company_name;
const cashUsd = (player.cash_usd_cents / 100).toFixed(0);
const mrrUsd = (player.mrr_usd_cents / 100).toFixed(0);
const founded = new Date(player.founded_at * 1000).getFullYear();
const dayNum = Math.max(1, Math.floor((Date.now() / 1000 - player.founded_at) / 86400) + 1);
const initials = companyName.split(/\s+/).map((w: string) => w[0] ?? '').join('').slice(0, 2).toUpperCase() || 'HY';
const displayName = user.display_name ?? user.email.split('@')[0] ?? 'player';
// AikaHub-kötés (src/lib/aikahub.ts). AikaHub-fiókos usernek nincs valódi e-mail-címe: a helyőrzőt nem mutatjuk.
const aikahub = await getAikahubLink(db, user.id);
const aikahubOnly = user.email.endsWith(NO_PASSWORD_EMAIL_DOMAIN);
const url = new URL(Astro.request.url);
const aikahubError = url.searchParams.get('aikahub_error');
const aikahubCsrf = aikahub ? '' : await linkCsrfToken(getSessionCookie(ctx) ?? '');

const proUntilStr = player.pro_until
  ? new Date(player.pro_until * 1000).toISOString().slice(0, 10)
  : null;
const proDaysLeft = player.pro_until
  ? Math.max(0, Math.floor((player.pro_until - Date.now() / 1000) / 86400))
  : 0;
const stateObj = {
  company: companyName,
  initials,
  cashUsd,
  mrrUsd,
  rep: player.reputation,
  era: player.current_era,
  founded,
  day: dayNum,
  email: aikahubOnly ? `AikaHub: ${aikahub?.nickname ?? displayName}` : user.email,
  displayName,
  city: player.city ?? '—',
  isPro,
  proUntil: proUntilStr,
  proDaysLeft,
  llmUsed,
  llmCap,
  shiftsToday,
};
const pageCss = "\n  .layout { grid-column: span 12; display: grid; grid-template-columns: 220px 1fr; gap: 18px; }\n\n  /* Settings nav */\n  .set-nav {\n    position: sticky; top: 18px;\n    background: var(--panel); border: 1px solid var(--line);\n    border-radius: 12px; padding: 8px;\n  }\n  .set-nav a {\n    display: grid; grid-template-columns: 22px 1fr;\n    align-items: center; gap: 10px;\n    padding: 8px 10px; border-radius: 7px;\n    font-size: 13px; color: var(--muted);\n    cursor: pointer; transition: background .12s;\n  }\n  .set-nav a:hover { background: var(--panel-2); color: var(--text); }\n  .set-nav a.on { background: var(--panel-2); color: var(--text); }\n  .set-nav a .ico { font-family: var(--mono); color: var(--dim); }\n  .set-nav a.on .ico { color: var(--cyan); }\n\n  /* Section card */\n  .sec {\n    background: var(--panel); border: 1px solid var(--line);\n    border-radius: 12px; padding: 0;\n    margin-bottom: 18px;\n  }\n  .sec-head {\n    padding: 18px 22px 14px;\n    border-bottom: 1px solid var(--line);\n  }\n  .sec-head h2 {\n    margin: 0;\n    font-family: var(--display); font-size: 19px; font-weight: 600;\n    display: flex; align-items: center; gap: 10px;\n  }\n  .sec-head h2 .ico {\n    width: 28px; height: 28px; border-radius: 7px;\n    background: var(--panel-2); border: 1px solid var(--line-2);\n    display: grid; place-items: center;\n    font-family: var(--mono); font-size: 13px; color: var(--cyan);\n  }\n  .sec-head .sub {\n    font-size: 13px; color: var(--muted); margin-top: 4px;\n  }\n\n  .field {\n    padding: 16px 22px;\n    border-bottom: 1px solid var(--line);\n    display: grid; grid-template-columns: 1fr 280px;\n    gap: 24px; align-items: center;\n  }\n  .field:last-child { border-bottom: 0; }\n  .field .label {\n    font-weight: 500; font-size: 14px; color: var(--text);\n  }\n  .field .label small {\n    display: block; font-weight: 400; font-size: 12px;\n    color: var(--muted); margin-top: 3px; line-height: 1.5;\n  }\n  .field .ctrl { display: flex; justify-content: flex-end; align-items: center; gap: 8px; }\n  .field .warn-note {\n    margin-top: 8px;\n    font-family: var(--mono); font-size: 11px;\n    color: var(--amber);\n    display: flex; gap: 6px; align-items: center;\n  }\n\n  /* Toggle */\n  .toggle {\n    width: 44px; height: 24px; border-radius: 999px;\n    background: var(--panel-3); border: 1px solid var(--line-2);\n    position: relative; cursor: pointer; flex: none;\n    transition: background .15s;\n  }\n  .toggle::after {\n    content: \"\"; position: absolute; top: 2px; left: 2px;\n    width: 18px; height: 18px; border-radius: 50%;\n    background: var(--text); transition: transform .15s;\n  }\n  .toggle.on { background: var(--mint); border-color: var(--mint); }\n  .toggle.on::after { transform: translateX(20px); background: #07120c; }\n\n  /* Segmented control */\n  .seg {\n    display: inline-flex; background: var(--panel-2); border: 1px solid var(--line);\n    border-radius: 7px; padding: 2px;\n  }\n  .seg button {\n    padding: 6px 12px; border-radius: 5px;\n    background: transparent; border: 0;\n    color: var(--muted); font-family: var(--mono); font-size: 11px; font-weight: 500;\n  }\n  .seg button.on { background: var(--text); color: var(--bg); }\n\n  /* Slider */\n  .slider {\n    display: grid; grid-template-columns: 1fr 44px; gap: 12px;\n    align-items: center; width: 240px;\n  }\n  .slider .track {\n    height: 4px; background: var(--line); border-radius: 2px;\n    position: relative;\n  }\n  .slider .track i {\n    position: absolute; left: 0; top: 0; bottom: 0;\n    background: var(--cyan); border-radius: 2px;\n  }\n  .slider .track i::after {\n    content: \"\"; position: absolute; right: -7px; top: 50%; transform: translateY(-50%);\n    width: 14px; height: 14px; border-radius: 50%; background: var(--text);\n    border: 2px solid var(--bg); box-shadow: 0 0 0 1px var(--cyan);\n  }\n  .slider .num {\n    font-family: var(--mono); font-size: 12px; font-weight: 700; text-align: right;\n  }\n\n  /* Select */\n  .select {\n    padding: 8px 12px; border-radius: 7px;\n    background: var(--panel-2); border: 1px solid var(--line);\n    color: var(--text); font-family: var(--mono); font-size: 12px;\n    min-width: 180px; cursor: pointer;\n    background-image: linear-gradient(45deg, transparent 50%, var(--muted) 50%), linear-gradient(135deg, var(--muted) 50%, transparent 50%);\n    background-position: calc(100% - 13px) 14px, calc(100% - 9px) 14px;\n    background-size: 4px 4px, 4px 4px;\n    background-repeat: no-repeat;\n    appearance: none;\n  }\n\n  /* Color swatch row */\n  .swatches { display: flex; gap: 6px; }\n  .swatch {\n    width: 26px; height: 26px; border-radius: 7px;\n    border: 2px solid transparent;\n    cursor: pointer;\n  }\n  .swatch.on { border-color: var(--text); box-shadow: 0 0 0 1px var(--bg) inset; }\n\n  /* Profile head */\n  .profile-head {\n    padding: 22px;\n    display: grid; grid-template-columns: 72px 1fr auto;\n    gap: 18px; align-items: center;\n  }\n  .profile-head .av {\n    width: 72px; height: 72px; border-radius: 18px;\n    background: linear-gradient(135deg, var(--indigo), #4f46e5);\n    display: grid; place-items: center;\n    font-family: var(--display); font-size: 30px; font-weight: 700; color: #fff;\n    position: relative;\n  }\n  .profile-head .av .edit {\n    position: absolute; bottom: -4px; right: -4px;\n    width: 24px; height: 24px; border-radius: 50%;\n    background: var(--bg); border: 2px solid var(--line-2);\n    display: grid; place-items: center;\n    font-size: 11px; color: var(--text);\n  }\n  .profile-head h3 {\n    margin: 0; font-family: var(--display); font-size: 22px; font-weight: 600;\n    display: flex; align-items: center; gap: 8px;\n  }\n  .profile-head .handle {\n    font-family: var(--mono); font-size: 12px; color: var(--dim);\n    margin-top: 4px;\n  }\n  .profile-head .meta {\n    margin-top: 8px;\n    font-family: var(--mono); font-size: 11px; color: var(--muted);\n    display: flex; gap: 14px;\n  }\n  .profile-head .meta b { color: var(--text); }\n  .profile-head .actions { display: flex; gap: 8px; }\n\n  /* Save bar */\n  .save-bar {\n    position: sticky; bottom: 0;\n    background: rgba(13,17,28,.92); backdrop-filter: blur(8px);\n    border-top: 1px solid var(--line-2);\n    padding: 14px 22px;\n    margin: 0 -28px -16px;\n    display: flex; align-items: center; gap: 14px;\n    z-index: 5;\n  }\n  .save-bar .status {\n    font-family: var(--mono); font-size: 12px; color: var(--mint);\n    display: flex; align-items: center; gap: 8px;\n  }\n  .save-bar .status i { width: 8px; height: 8px; border-radius: 50%; background: var(--mint); box-shadow: 0 0 6px var(--mint); }\n  .save-bar .right { margin-left: auto; display: flex; gap: 8px; }\n\n  /* Danger zone */\n  .danger {\n    border-color: rgba(244,63,94,.3) !important;\n    background: linear-gradient(180deg, rgba(244,63,94,.04), var(--panel));\n  }\n  .danger .sec-head h2 .ico { color: var(--pink); background: rgba(244,63,94,.1); border-color: rgba(244,63,94,.3); }\n\n  @media (max-width: 980px) {\n    .layout { grid-template-columns: 1fr; }\n    .field { grid-template-columns: 1fr; gap: 12px; }\n    .field .ctrl { justify-content: flex-start; }\n  }\n";
const pageHtml = "\n<div class=\"app\">\n  <aside>\n    <a class=\"brand\" href=\"/play\"><div class=\"brand-mark\"></div>Hyperscales</a>\n    <div class=\"company-card\">\n      <div class=\"row\"><div class=\"crest\">SN</div><div><div class=\"name\">SyncNode <span class=\"edit\">✎</span></div><div class=\"sub\">EST 2026 · ERA 1 · DAY 12</div></div></div>\n      <div class=\"runway\"><span>Runway</span><b>26 days</b></div>\n      <div class=\"bar\"><i></i></div>\n    </div>\n    <div class=\"nav-section\">\n      <div class=\"nav-head\" data-i18n=\"dash.nav.operate\">Operate</div>\n      <a class=\"nav-item\" href=\"/play\"><span class=\"ico\">▣</span> <span data-i18n=\"dash.nav.dashboard\">Dashboard</span></a>\n      <a class=\"nav-item\" href=\"/play/servers\"><span class=\"ico\">▤</span> <span data-i18n=\"dash.nav.servers\">Servers</span> <span class=\"badge muted\">2</span></a>\n      <a class=\"nav-item\" href=\"/play/customers\"><span class=\"ico\">◉</span> <span data-i18n=\"dash.nav.customers\">Customers</span> <span class=\"badge new\">+1</span></a>\n      <a class=\"nav-item\" href=\"/play/tickets\"><span class=\"ico\">✉</span> <span data-i18n=\"dash.nav.tickets\">Tickets</span> <span class=\"badge\">3</span></a>\n      <a class=\"nav-item\" href=\"/play/finance\"><span class=\"ico\">$</span> <span data-i18n=\"dash.nav.finance\">Finance</span></a>\n    </div>\n    <div class=\"nav-section\">\n      <div class=\"nav-head\" data-i18n=\"dash.nav.grow\">Grow</div>\n      <a class=\"nav-item\" href=\"/play/research\"><span class=\"ico\">⚙</span> <span data-i18n=\"dash.nav.research\">Research</span> <span class=\"badge muted\">0/12</span></a>\n      <a class=\"nav-item\" href=\"/play/marketplace\"><span class=\"ico\">◈</span> <span data-i18n=\"dash.nav.marketplace\">Marketplace</span></a>\n      <a class=\"nav-item locked\" href=\"/play/staff\"><span class=\"ico\">☰</span> <span data-i18n=\"dash.nav.staff\">Staff</span> <span class=\"lock\">🔒 Era 2</span></a>\n      <a class=\"nav-item locked\" href=\"/play/network\"><span class=\"ico\">◴</span> <span data-i18n=\"dash.nav.network\">Network</span> <span class=\"lock\">🔒 Era 2</span></a>\n    </div>\n    <div class=\"nav-section\">\n      <div class=\"nav-head\" data-i18n=\"dash.nav.meta\">Meta</div>\n      <a class=\"nav-item\" href=\"/play/leaderboard\"><span class=\"ico\">⌖</span> <span data-i18n=\"dash.nav.leaderboard\">Leaderboard</span></a>\n      <a class=\"nav-item\" href=\"/play/devlog\"><span class=\"ico\">▶</span> <span data-i18n=\"dash.nav.devlog\">Devlog</span></a>\n      <a class=\"nav-item active\"><span class=\"ico\">⚒</span> <span data-i18n=\"dash.nav.settings\">Settings</span></a>\n    </div>\n    <div class=\"side-foot\"><div>v0.7.2 · build 18,402</div><a href=\"#\">⌨ Shortcuts ⌘K</a><div class=\"me\"><span class=\"ava\">P</span>promnet · log out</div></div>\n  </aside>\n\n  <main>\n    <header class=\"topbar\">\n      <div class=\"crumbs\"><span>Meta</span><span class=\"sep\">›</span><b>Settings</b><span class=\"sep\">›</span><span>Profile, gameplay, AI, audio, data</span></div>\n      <div class=\"clock\"><div class=\"day\">Day 12<small> / 365</small></div><div class=\"time\">03:42 AM</div><div class=\"ctrls\"><button>‖</button><button class=\"on\">▶</button><button>▶▶</button></div></div>\n      <div class=\"topbar-stats\">\n        <div class=\"tstat\"><span class=\"k\" data-i18n=\"dash.topbar.cash\">Cash</span><span class=\"v\">$390<small>+$45/d</small></span></div>\n        <div class=\"tstat\"><span class=\"k\" data-i18n=\"dash.topbar.mrr\">MRR</span><span class=\"v\">$15<small>+$0</small></span></div>\n        <div class=\"tstat\"><span class=\"k\" data-i18n=\"dash.topbar.rep\">Rep</span><span class=\"v\">50<small class=\"dn\">−2</small></span></div>\n      </div>\n      <div class=\"topbar-actions\"><button class=\"bell\" data-count=\"4\">🔔</button></div>\n    </header>\n\n    <div class=\"content\">\n      <div class=\"pagehead\">\n        <div class=\"h-left\">\n          <h1>Settings <span class=\"count\">Auto-saved 2s ago</span></h1>\n          <div class=\"sub\">Tune your save, your face, your AI advisor, and your pager.</div>\n        </div>\n        <div class=\"h-right\">\n          <button class=\"btn\">Reset to defaults</button>\n          <button class=\"btn primary\">Export save (.json)</button>\n        </div>\n      </div>\n\n      <div class=\"layout\">\n\n        <!-- Settings sub-nav -->\n        <nav class=\"set-nav\">\n          <a class=\"on\"><span class=\"ico\">◉</span>Profile</a>\n          <a><span class=\"ico\">▶</span>Gameplay</a>\n          <a><span class=\"ico\">⚙</span>AI advisor</a>\n          <a><span class=\"ico\">✉</span>Notifications</a>\n          <a><span class=\"ico\">♪</span>Audio</a>\n          <a><span class=\"ico\">▣</span>Display &amp; UI</a>\n          <a><span class=\"ico\">⌨</span>Controls</a>\n          <a><span class=\"ico\">⌖</span>Multiplayer</a>\n          <a><span class=\"ico\">💾</span>Save &amp; data</a>\n          <a><span class=\"ico\">⚠</span>Danger zone</a>\n        </nav>\n\n        <!-- Right column -->\n        <div>\n\n          <!-- Profile -->\n          <section class=\"sec\">\n            <div class=\"sec-head\">\n              <h2><span class=\"ico\">◉</span> Profile</h2>\n              <div class=\"sub\">How you show up on leaderboards and other players' reputation pages.</div>\n            </div>\n            <div class=\"profile-head\">\n              <div class=\"av\">P<span class=\"edit\">✎</span></div>\n              <div>\n                <h3>promnet <span style=\"font-family:var(--mono);font-size:11px;color:var(--mint);padding:3px 8px;border-radius:999px;background:rgba(52,211,153,.12);border:1px solid rgba(52,211,153,.3);font-weight:700;letter-spacing:0.06em;text-transform:uppercase;\">VERIFIED</span></h3>\n                <div class=\"handle\">@syncnode · joined Season 1 · 142 hours played</div>\n                <div class=\"meta\">\n                  <span>Rank <b>#147</b></span>\n                  <span>Best <b>$1,402</b></span>\n                  <span>Saves <b>3</b></span>\n                  <span>Friends <b>8</b></span>\n                </div>\n              </div>\n              <div class=\"actions\">\n                <button class=\"btn sm\">Share /rep page</button>\n                <button class=\"btn sm\">Edit avatar</button>\n              </div>\n            </div>\n            <div class=\"field\">\n              <div class=\"label\">Display name<small>Shown on leaderboards and in customer tickets.</small></div>\n              <div class=\"ctrl\">\n                <input class=\"select\" value=\"promnet\" style=\"font-family: var(--mono);\" />\n              </div>\n            </div>\n            <div class=\"field\">\n              <div class=\"label\">Company name<small>Your in-game brand. Customers see this on invoices.</small></div>\n              <div class=\"ctrl\">\n                <input class=\"select\" value=\"SyncNode\" style=\"font-family: var(--mono);\" />\n              </div>\n            </div>\n            <div class=\"field\">\n              <div class=\"label\">Public reputation page<small>Lets others link to your stats. Disable to stay anonymous.</small></div>\n              <div class=\"ctrl\"><div class=\"toggle on\"></div></div>\n            </div>\n            <div class=\"field\">\n              <div class=\"label\">Show on global leaderboard<small>Your rank and score still update — just hidden from the public ladder.</small></div>\n              <div class=\"ctrl\"><div class=\"toggle on\"></div></div>\n            </div>\n          </section>\n\n          <!-- Gameplay -->\n          <section class=\"sec\">\n            <div class=\"sec-head\">\n              <h2><span class=\"ico\">▶</span> Gameplay</h2>\n              <div class=\"sub\">Tune difficulty, pacing, and how forgiving the sim is.</div>\n            </div>\n            <div class=\"field\">\n              <div class=\"label\">Difficulty<small>Adjusts customer churn rates, P1 spawn frequency, and starting cash.</small></div>\n              <div class=\"ctrl\">\n                <div class=\"seg\">\n                  <button>Casual</button>\n                  <button class=\"on\">Standard</button>\n                  <button>Hard</button>\n                  <button>Karen mode</button>\n                </div>\n              </div>\n            </div>\n            <div class=\"field\">\n              <div class=\"label\">Game speed multiplier<small>1 in-game day = N seconds of real time. The pause button still works.</small></div>\n              <div class=\"ctrl\">\n                <div class=\"slider\"><div class=\"track\"><i style=\"width:60%;\"></i></div><span class=\"num\">1.5×</span></div>\n              </div>\n            </div>\n            <div class=\"field\">\n              <div class=\"label\">Auto-pause on P1 ticket<small>Stop the sim when a fire starts so you can read before you panic.</small></div>\n              <div class=\"ctrl\"><div class=\"toggle on\"></div></div>\n            </div>\n            <div class=\"field\">\n              <div class=\"label\">Show tutorial hints<small>Era 1 only. New mechanics get a popup the first time they appear.</small></div>\n              <div class=\"ctrl\"><div class=\"toggle\"></div></div>\n            </div>\n            <div class=\"field\">\n              <div class=\"label\">Permadeath mode<small>If you go bankrupt, the save is sealed. No rewinds. Leaderboard flair.</small></div>\n              <div class=\"ctrl\">\n                <div class=\"toggle\"></div>\n              </div>\n            </div>\n          </section>\n\n          <!-- AI advisor -->\n          <section class=\"sec\">\n            <div class=\"sec-head\">\n              <h2><span class=\"ico\">⚙</span> AI advisor</h2>\n              <div class=\"sub\">\"Lin-1\" reads your sim and surfaces what's about to break. Configure how loud she gets.</div>\n            </div>\n            <div class=\"field\">\n              <div class=\"label\">Advisor model<small>Controls quality of suggestions. Premium runs your own API key — slower but smarter.</small></div>\n              <div class=\"ctrl\">\n                <select class=\"select\">\n                  <option>Built-in (free)</option>\n                  <option>Claude Haiku · default</option>\n                  <option>Claude Sonnet · premium</option>\n                  <option>BYO API key</option>\n                </select>\n              </div>\n            </div>\n            <div class=\"field\">\n              <div class=\"label\">Suggestion frequency<small>How often Lin-1 pops up with proactive advice.</small></div>\n              <div class=\"ctrl\">\n                <div class=\"seg\"><button>Off</button><button>Low</button><button class=\"on\">Med</button><button>High</button></div>\n              </div>\n            </div>\n            <div class=\"field\">\n              <div class=\"label\">Auto-action threshold<small>If confidence is above this, Lin acts without asking (e.g. auto-refund a $19 ticket).</small></div>\n              <div class=\"ctrl\">\n                <div class=\"slider\"><div class=\"track\"><i style=\"width:85%;\"></i></div><span class=\"num\">95%</span></div>\n              </div>\n            </div>\n            <div class=\"field\">\n              <div class=\"label\">Personality<small>How Lin-1 talks to you. Affects copy in advisor banner.</small></div>\n              <div class=\"ctrl\">\n                <div class=\"seg\"><button>Dry</button><button class=\"on\">Direct</button><button>Warm</button><button>Snarky</button></div>\n              </div>\n            </div>\n          </section>\n\n          <!-- Notifications -->\n          <section class=\"sec\">\n            <div class=\"sec-head\">\n              <h2><span class=\"ico\">✉</span> Notifications &amp; pager</h2>\n              <div class=\"sub\">When and how the game interrupts you. Yes, this is the famous \"pager\" panel.</div>\n            </div>\n            <div class=\"field\">\n              <div class=\"label\">In-game pager — P1 tickets<small>Sound + screen flash when a P1 fires.</small></div>\n              <div class=\"ctrl\"><div class=\"toggle on\"></div></div>\n            </div>\n            <div class=\"field\">\n              <div class=\"label\">Desktop notifications<small>Push notifications when you alt-tab away from the game.</small></div>\n              <div class=\"ctrl\"><div class=\"toggle on\"></div></div>\n            </div>\n            <div class=\"field\">\n              <div class=\"label\">\"Quiet hours\"<small>Pages defer to a daily summary. Honored by P1+. Configure schedule below.</small></div>\n              <div class=\"ctrl\"><div class=\"toggle on\"></div></div>\n            </div>\n            <div class=\"field\">\n              <div class=\"label\">Quiet hours window<small>Real clock time. Game still runs; you just sleep.</small></div>\n              <div class=\"ctrl\">\n                <select class=\"select\" style=\"min-width:130px;\">\n                  <option>11 PM → 7 AM</option>\n                </select>\n              </div>\n            </div>\n            <div class=\"field\">\n              <div class=\"label\">Email digest<small>Daily summary of overnight events.</small></div>\n              <div class=\"ctrl\">\n                <select class=\"select\"><option>Daily 9 AM</option></select>\n              </div>\n            </div>\n          </section>\n\n          <!-- Audio + UI -->\n          <section class=\"sec\">\n            <div class=\"sec-head\">\n              <h2><span class=\"ico\">♪</span> Audio &amp; UI</h2>\n            </div>\n            <div class=\"field\">\n              <div class=\"label\">Master volume</div>\n              <div class=\"ctrl\"><div class=\"slider\"><div class=\"track\"><i style=\"width:70%;\"></i></div><span class=\"num\">70</span></div></div>\n            </div>\n            <div class=\"field\">\n              <div class=\"label\">Pager / alert sounds<small>The 3 AM noise. Tunable.</small></div>\n              <div class=\"ctrl\"><div class=\"slider\"><div class=\"track\"><i style=\"width:45%;\"></i></div><span class=\"num\">45</span></div></div>\n            </div>\n            <div class=\"field\">\n              <div class=\"label\">Ambient datacenter hum<small>Fans, HVAC, distant beeping.</small></div>\n              <div class=\"ctrl\"><div class=\"slider\"><div class=\"track\"><i style=\"width:30%;\"></i></div><span class=\"num\">30</span></div></div>\n            </div>\n            <div class=\"field\">\n              <div class=\"label\">UI theme<small>Dark \"rack room\" is canon.</small></div>\n              <div class=\"ctrl\">\n                <div class=\"seg\"><button class=\"on\">Dark</button><button>Amber CRT</button><button>High contrast</button></div>\n              </div>\n            </div>\n            <div class=\"field\">\n              <div class=\"label\">Accent color</div>\n              <div class=\"ctrl\">\n                <div class=\"swatches\">\n                  <div class=\"swatch on\" style=\"background:#22d3ee;\"></div>\n                  <div class=\"swatch\" style=\"background:#6366f1;\"></div>\n                  <div class=\"swatch\" style=\"background:#34d399;\"></div>\n                  <div class=\"swatch\" style=\"background:#f59e0b;\"></div>\n                  <div class=\"swatch\" style=\"background:#f43f5e;\"></div>\n                  <div class=\"swatch\" style=\"background:#a78bfa;\"></div>\n                </div>\n              </div>\n            </div>\n            <div class=\"field\">\n              <div class=\"label\">UI density<small>Cozy = more whitespace. Compact = more data per screen.</small></div>\n              <div class=\"ctrl\">\n                <div class=\"seg\"><button>Cozy</button><button class=\"on\">Normal</button><button>Compact</button></div>\n              </div>\n            </div>\n            <div class=\"field\">\n              <div class=\"label\">Reduce motion<small>Disables clock ticking animations and event-feed slide-ins.</small></div>\n              <div class=\"ctrl\"><div class=\"toggle\"></div></div>\n            </div>\n          </section>\n\n          <!-- Save & data -->\n          <section class=\"sec\">\n            <div class=\"sec-head\">\n              <h2><span class=\"ico\">💾</span> Save &amp; data</h2>\n            </div>\n            <div class=\"field\">\n              <div class=\"label\">Cloud sync<small>3 saves synced across devices. Conflict resolution by last-write.</small></div>\n              <div class=\"ctrl\"><div class=\"toggle on\"></div></div>\n            </div>\n            <div class=\"field\">\n              <div class=\"label\">Auto-save interval<small>Real-time minutes between snapshots.</small></div>\n              <div class=\"ctrl\">\n                <select class=\"select\"><option>Every 2 minutes</option></select>\n              </div>\n            </div>\n            <div class=\"field\">\n              <div class=\"label\">Anonymous gameplay telemetry<small>Helps us tune difficulty. No content, no chat.</small></div>\n              <div class=\"ctrl\"><div class=\"toggle on\"></div></div>\n            </div>\n            <div class=\"field\">\n              <div class=\"label\">Active save · \"SyncNode\"<small>3 saves · last opened Day 12 · 142 hours total</small></div>\n              <div class=\"ctrl\">\n                <button class=\"btn sm\">Manage saves →</button>\n              </div>\n            </div>\n          </section>\n\n          <!-- Danger zone -->\n          <section class=\"sec danger\">\n            <div class=\"sec-head\">\n              <h2><span class=\"ico\">⚠</span> Danger zone</h2>\n              <div class=\"sub\">Permanent. Cannot be undone. Read twice.</div>\n            </div>\n            <div class=\"field\">\n              <div class=\"label\">Reset current save<small>Wipes Day 12 progress. Keeps your profile, leaderboard history, badges.</small></div>\n              <div class=\"ctrl\"><button class=\"btn sm\" style=\"border-color: rgba(244,63,94,.3); color: var(--pink);\">Reset save</button></div>\n            </div>\n            <div class=\"field\">\n              <div class=\"label\">Forfeit season<small>Removes you from Season 3 ladder. You can rejoin next season.</small></div>\n              <div class=\"ctrl\"><button class=\"btn sm\" style=\"border-color: rgba(244,63,94,.3); color: var(--pink);\">Forfeit</button></div>\n            </div>\n            <div class=\"field\">\n              <div class=\"label\">Delete account<small>Removes profile, saves, friends, achievements, /rep page. Permanent.</small></div>\n              <div class=\"ctrl\"><button class=\"btn sm\" style=\"background: var(--pink); border-color: var(--pink); color: #fff;\">Delete account</button></div>\n            </div>\n          </section>\n\n          <!-- Sticky save bar -->\n          <div class=\"save-bar\">\n            <div class=\"status\"><i></i>All changes saved · 2s ago</div>\n            <div class=\"right\">\n              <button class=\"btn\">Discard</button>\n              <button class=\"btn primary\">Apply &amp; resume sim</button>\n            </div>\n          </div>\n\n        </div>\n      </div>\n    </div>\n  </main>\n</div>\n";
// Közös keret (oldalsáv + felső sáv) valós adatból, a játékos nyelvén — src/lib/play/shell.ts
const locale = await resolveLocale({ request: Astro.request, db, userId: user.id });
const shell = await loadShell(db, player, user, locale);
const prefLang = (player as { preferred_lang?: string }).preferred_lang;
const settingsContent = renderSettingsContent({
  shell,
  displayName,
  emailLabel: stateObj.email,
  city: player.city,
  preferredLang: prefLang === 'hu' || prefLang === 'de' ? prefLang : 'en',
  isPro, proUntil: proUntilStr, llmUsed, llmCap, shiftsToday,
  freeCap: FREE_DAILY_CAP, proCap: PRO_DAILY_CAP,
  aikahub: aikahub ? { nickname: aikahub.nickname, avatar_url: aikahub.avatar_url ?? null, profile_url: aikahub.profile_url ?? null } : null,
  aikahubCsrf, aikahubError,
});
const shellHtml = applyContent(applyShell(pageHtml, shell, 'settings', [pt(locale, 'nav.settings')]), settingsContent);
const setT = {
  saving: pt(locale, 'set.saving'), saved: pt(locale, 'set.saved'), short: pt(locale, 'set.err_short'),
  error: pt(locale, 'toast.error', { msg: '{msg}' }),
};
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Hyperscales — Settings</title>
<link rel="stylesheet" href={templateCssUrl} />
<link rel="stylesheet" href={playShellCssUrl} />
<style is:global set:html={pageCss}></style>
<style is:inline>
  body { transition: opacity 200ms ease-out; }
  body.preload { opacity: 0; }
</style>
  <script is:inline defer src="https://stats.aika.hu/aika.js" data-website-id="4edd333d-1a25-461f-bcd3-25a8bcf7f694" data-domains="hyperscales.app,www.hyperscales.app"></script>
</head>
<body class="preload">
<Fragment set:html={shellHtml} />
<script type="application/json" id="set-i18n" set:html={jsonForScript(setT)}></script>
<script is:inline>
  // Minden művelet data-action alapján kötődik — NEM a gomb felirata alapján (a régi /Delete account|Fiók törlése/
  // regex németül nem talált, így a „Konto löschen" semmit sem csinált).
  (function () {
    var T = JSON.parse(document.getElementById('set-i18n').textContent);
    var langRow = document.getElementById('set-lang-row');
    var currentLang = langRow ? (langRow.getAttribute('data-current') || 'en') : 'en';
    if (langRow) langRow.querySelectorAll('.lang-pick').forEach(function (b) {
      b.addEventListener('click', function () {
        currentLang = b.getAttribute('data-lang');
        langRow.querySelectorAll('.lang-pick').forEach(function (x) {
          x.classList.toggle('on', x === b);
          x.setAttribute('aria-pressed', x === b ? 'true' : 'false');
        });
      });
    });
    function fail(btn, label, err) {
      btn.disabled = false;
      btn.textContent = label;
      var msg = T.error.replace('{msg}', err && err.message ? err.message : String(err));
      if (window.hsToast) window.hsToast(msg, 'bad'); else alert(msg);
    }
    var actions = {
      'save-profile': async function (btn) {
        var status = document.getElementById('set-status');
        var cn = document.getElementById('set-company-name').value.trim();
        var city = document.getElementById('set-city').value.trim();
        if (cn.length < 2) { status.textContent = T.short; status.className = 'set-status bad'; return; }
        status.textContent = T.saving; status.className = 'set-status';
        btn.disabled = true;
        try {
          var r = await fetch('/api/game/settings', {
            method: 'PATCH', headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ company_name: cn, city: city || null, preferred_lang: currentLang }),
          });
          var j = await r.json().catch(function () { return {}; });
          if (!r.ok || !j.ok) throw new Error(j.message || j.error || ('HTTP ' + r.status));
          try { localStorage.setItem('hs_lang', currentLang); } catch (e) {}
          document.cookie = 'hs_lang=' + currentLang + '; path=/; max-age=31536000; samesite=lax';
          status.textContent = T.saved; status.className = 'set-status ok';
          setTimeout(function () { location.reload(); }, 700);
        } catch (e) {
          btn.disabled = false;
          status.textContent = T.error.replace('{msg}', e.message); status.className = 'set-status bad';
        }
      },
      'reset-save': async function (btn, label) {
        var r = await fetch('/api/game/reset', { method: 'POST' });
        var j = await r.json().catch(function () { return {}; });
        if (!r.ok || j.ok === false) throw new Error(j.message || j.error || ('HTTP ' + r.status));
        location.href = '/play';
      },
      'delete-account': async function (btn, label) {
        var r = await fetch('/api/auth/delete', { method: 'POST' });
        var j = await r.json().catch(function () { return {}; });
        if (!r.ok || j.ok === false) throw new Error(j.message || j.error || ('HTTP ' + r.status));
        location.href = '/';
      },
    };
    document.querySelectorAll('[data-action]').forEach(function (btn) {
      var fn = actions[btn.getAttribute('data-action')];
      if (!fn) return;
      btn.addEventListener('click', async function (e) {
        e.preventDefault();
        var confirmMsg = btn.getAttribute('data-confirm');
        if (confirmMsg && !confirm(confirmMsg)) return;
        var label = btn.textContent;
        if (btn.getAttribute('data-action') !== 'save-profile') { btn.disabled = true; btn.textContent = '⏳…'; }
        try { await fn(btn, label); } catch (err) { fail(btn, label, err); }
      });
    });
  })();
</script>
<script is:inline>
  // Hide mock-data flash: remove preload-class once hydrators have run.
  window.addEventListener('load', function () {
    setTimeout(function () { document.body.classList.remove('preload'); }, 30);
  });
</script>
<I18nDashboard />
<DashboardAnims />
<script is:inline src="/js/play-shell.js"></script>
</body>
</html>
